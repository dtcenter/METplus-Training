[
  {
    "source_image": "Screen Shot 2024-05-07 at 10.26.29 AM.png",
    "type": "math",
    "latex": "\\[\\text{Accuracy } = \\frac{{Hits} + {Correct\\ Rejections}}{n}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_POD_eq.png",
    "type": "math",
    "latex": "\\[\\text{POD} = \\frac{Hits} {{Hits} + {Misses}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_POFD_eq.png",
    "type": "math",
    "latex": "\\[\\text{POFD} = \\frac{False\\ Alarms} {{Correct\\ Rejections} + {False\\ Alarms}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_Bias_eq.png",
    "type": "math",
    "latex": "\\[\\text{Bias} = \\frac{{Hits} + {False\\ Alarms}} {{Hits} + {Misses}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_FAR_eq.png",
    "type": "math",
    "latex": "\\[\\text{FAR} = \\frac{False\\ Alarms} {{Hits} + {False\\ Alarms}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_CSI_eq.png",
    "type": "math",
    "latex": "\\[\\text{CSI} = \\frac{Hits} {{Hits} + {Misses} + {False\\ Alarms}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_HSS_eq.png",
    "type": "math",
    "latex": "\\[\\text{HSS} = \\frac{{Hits} + {Correct\\ Rejections} - {C_{2}}} {{n} - {C_{2}}}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_C2_eq.png",
    "type": "math",
    "latex": "\\[C_2 = \\frac{(Hits + Misses) (Hits + FA) + (CR + Misses) (CR + FA)}{n}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_HK_eq.png",
    "type": "math",
    "latex": "\\[\\text{HK } = \\frac{(Hits * Correct\\ Rejections) - (False\\ Alarms * Misses)}{(Hits + Misses) (False\\ Alarms + Correct Rejections)}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_GSS_eq.png",
    "type": "math",
    "latex": "\\[\\text{GSS } = \\frac{Hits - C_1}{Hits + False\\ Alarms + Misses - C_1}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_C1_eq.png",
    "type": "math",
    "latex": "\\[C_1 = \\frac{(Hits + False\\ Alarms) (Hits + Misses)}{n}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_Acc_general_eq_0.png",
    "type": "math",
    "latex": "\\[Acc = \\frac{1}{n} \\sum t(F_i O_i)\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_HSS_multicat_eq_0.png",
    "type": "math",
    "latex": "\\[HSS = \\frac{\\frac{1}{n}\\sum t(F_i O_i) - \\frac{1}{n^2}\\sum t(F_i) t(O_i)}{1 - \\frac{1}{n^2}\\sum t(F_i) t(O_i)}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_HK_multicat_eq.png",
    "type": "math",
    "latex": "\\[HK = \\frac{\\frac{1}{n}\\sum t(F_i O_i) - \\frac{1}{n^2}\\sum t(F_i) t(O_i)}{1 - \\frac{1}{n^2}\\sum (t(O_i))^2}\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_Ger_weight1.png",
    "type": "math",
    "latex": "\\[s_{j,j} = \\frac{1}{J-1}\\left[\\sum \\frac{1}{D(r)} + \\sum D(r)\\right]\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_Ger_weight2.png",
    "type": "math",
    "latex": "\\[s_{i,j} = \\frac{1}{J-1}\\left[\\sum \\frac{1}{D(r)} + \\sum D(r) - (j - i)\\right]\\]"
  },
  {
    "source_image": "5.0_Tutorial_stats_Ger_Likelihood_ratio.png",
    "type": "math",
    "latex": "\\[D(j) = \\frac{1 - \\sum p(o_r)}{\\sum p(o_r)}\\]"
  },
